    "react-dom": "19.2.3",
    "react-intl": "^8.0.6"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.8.4",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "typescript": "^5"
  }
}
