{
  "name": "playground-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"**/*.d.ts\" --out-file lang.json",
    "compile": "formatjs compile lang.json --out-file compiled/ko.json"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.7.2",
    "negotiator": "^1.0.0",
    "next": "16.1.0",
